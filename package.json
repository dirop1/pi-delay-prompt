{
  "name": "pi-delay-prompt",
  "version": "0.1.0",
  "description": "Delay the next Pi prompt with a visible countdown (useful for rate limits).",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/dirop1/pi-delay-prompt.git" },
  "homepage": "https://github.com/dirop1/pi-delay-prompt#readme",
  "bugs": { "url": "https://github.com/dirop1/pi-delay-prompt/issues" },
  "keywords": ["pi-package", "prompt", "delay", "rate-limit"],
